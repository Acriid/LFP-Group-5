%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ee850c578174c94a8ac88fe209aae22, type: 3}
  m_Name: initialKeycode
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObjectDialogu
  dialogueLines:
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I need to test this new card scanner mechanic to make sure it runs properly.
      If it does, one less area of code to check for\u2026"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: Whatever is happening.
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I just need to make sure I have the correct card for each room in my inventory
      and scan it by pressing \u2018E\u2019. "
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "At work, management insists on locking individual sections behind specific
      keycards. It\u2019s so annoying, I keep losing these things in my pockets!
      I think I\u2019ve sent 3 through the wash already."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "Even worse, they have terrible employee ID photos on them. The person
      behind the camera definitely enjoys choosing the picture you look the worst
      in to immortalize. Mine has me with my eyes closed! That\u2019s why there aren\u2019t
      ID pictures in my game."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "Blegh, I\u2019m rambling. Let\u2019s get to it."
