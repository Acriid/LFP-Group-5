%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ee850c578174c94a8ac88fe209aae22, type: 3}
  m_Name: VirusRealization
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObjectDialogu
  dialogueLines:
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "You know, I\u2019m just a simple person out here trying to break away
      from my 9 to 5. I have good intentions and a pure heart. I\u2019ve never opened
      phishing emails."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: " I don\u2019t click on mysterious internet links. I don\u2019t even illegally
      download movies! But somehow\u2026"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I\u2019ve contracted a virus."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "It\u2019s transforming my code. Morphing it into something I can barely
      understand."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "But I know it\u2019s nothing good. This virus is actively blocking me
      from progressing. That \u2018Art of War\u2019 comment is making a lot more
      sense now."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: What should I do?
