  m_Script: {fileID: 11500000, guid: 0ee850c578174c94a8ac88fe209aae22, type: 3}
  m_Name: startingDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObjectDialogu
  dialogueLines:
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "Woah, I went through my code and somethings\u2026"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: wrong.
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: "The concept of \u2018wrongness\u2019 is subjective."
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: "However, through analysis of your code I have identified\u2026"
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: "-\t4 critical flaws\r\n-\t52 areas requiring optimization\r\n-\tAnd 1
      exploited backdoor\r\n"
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: "Therefore, I can confirm that your use of the word, \u201Cwrong\u201D
      is an objective truth.\r\n"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "\u2026"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: Well, that was rude.
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "Huh, seems like this thing can view my code. Is it\u2026 inside the code?"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: I need to see how deep this error runs so that I can try patch it.
