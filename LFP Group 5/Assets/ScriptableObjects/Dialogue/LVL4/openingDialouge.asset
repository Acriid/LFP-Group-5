  dialogueLines:
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: '[SYSTEM DEFENSE LEVEL INCREASED]'
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: Direct attack on mainframe ineffective.
  - _characterIcon: {fileID: -8625906013721215279, guid: e8aef95697aea1b488e16f474f46c216, type: 3}
    line: Complete takeover is at 62%
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "What kind of virus is this? It\u2019s strong enough to overpower software
      specifically designed to combat it!"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I-I don\u2019t know what to do. All my hard work. My prototype. My chance
      at freedom. It\u2019s all\u2026"
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: Corrupted.
