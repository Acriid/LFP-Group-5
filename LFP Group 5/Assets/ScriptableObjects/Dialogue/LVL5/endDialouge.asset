  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ee850c578174c94a8ac88fe209aae22, type: 3}
  m_Name: endDialouge
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObjectDialogu
  dialogueLines:
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "It\u2019s awful quiet in here now."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "A bit lonely, some would say. The metaphorical \u201Csome\u201D is obviously
      not me. "
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I\u2019m not lonely."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "I\u2019ve also definitely not been talking to myself this whole time because
      I have no one else to talk to."
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: ...
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: ...
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: ...
  - _characterIcon: {fileID: -3607883123437360786, guid: 3ac0368c78cff2048958d9e1d88a407b, type: 3}
    line: "Y\u2019know what? This whole experience gives me an idea for a game."
